// PulseTrack — Competitor Intelligence Prisma Schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── NextAuth / Auth.js ───────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?

  accounts    Account[]
  sessions    Session[]
  competitors Competitor[]
  alerts      Alert[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── PulseTrack Domain ────────────────────────────────────────────────────────

enum PageType {
  HOMEPAGE
  PRICING
  FEATURES
  BLOG
  CHANGELOG
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
}

model Competitor {
  id        String   @id @default(cuid())
  userId    String
  name      String
  website   String
  logoUrl   String?
  isActive  Boolean  @default(true)
  frequency String   @default("daily")
  createdAt DateTime @default(now())

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages TrackedPage[]

  @@index([userId])
}

model TrackedPage {
  id            String    @id @default(cuid())
  competitorId  String
  pageType      PageType
  url           String
  lastScrapedAt DateTime?

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  snapshots  Snapshot[]

  @@unique([competitorId, pageType])
  @@index([competitorId])
}

model Snapshot {
  id            String   @id @default(cuid())
  trackedPageId String
  rawHtml       String   @db.Text
  cleanText     String   @db.Text
  scrapedAt     DateTime @default(now())

  trackedPage TrackedPage @relation(fields: [trackedPageId], references: [id], onDelete: Cascade)
  changes     Change[]

  @@index([trackedPageId])
}

model Change {
  id         String   @id @default(cuid())
  snapshotId String
  diffText   String   @db.Text
  aiAnalysis Json?
  urgency    Urgency  @default(LOW)
  isRead     Boolean  @default(false)
  detectedAt DateTime @default(now())

  snapshot Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  alerts   Alert[]

  @@index([snapshotId])
  @@index([detectedAt])
}

model Alert {
  id       String   @id @default(cuid())
  userId   String
  changeId String
  sentVia  String
  sentAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  change Change @relation(fields: [changeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([changeId])
}
