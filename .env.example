# Copy to .env and fill in real values. Never commit .env to git.

# Neon / PostgreSQL — pooled URL for app runtime
DATABASE_URL="postgresql://USER:PASSWORD@your-host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct URL for Prisma CLI migrations (no "-pooler" in hostname)
DIRECT_URL="postgresql://USER:PASSWORD@your-host.region.aws.neon.tech/neondb?sslmode=require"

# NextAuth (required in production)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Google OAuth (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend — magic link auth + digest emails
RESEND_API_KEY=""
RESEND_FROM_EMAIL="PulseTrack <onboarding@resend.dev>"

# Groq LLM (for AI change summaries)
GROQ_API_KEY=""

# Inngest (background cron agent)
# INNGEST_EVENT_KEY=""
# INNGEST_SIGNING_KEY=""

# Resend (weekly digest emails)
# RESEND_API_KEY=""
# RESEND_FROM_EMAIL="PulseTrack <digest@yourdomain.com>"
